# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- CLIENT-SAFE (bundled into the browser, must be prefixed VITE_) ---
# Safe to expose: RLS policies, not key secrecy, are what protect data.
VITE_SUPABASE_URL=https://oewopsufwtkpnkupnaqi.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- SERVER-ONLY (never prefix with VITE_ — must never reach the browser bundle) ---
# Bypasses RLS entirely. Only read inside src/lib/supabase/server.ts, which
# is only ever imported from createServerFn handlers.
SUPABASE_URL=https://oewopsufwtkpnkupnaqi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Used by src/lib/server-fns/audit-document.ts to call Gemini for document
# extraction. Server-only.
GEMINI_API_KEY=
